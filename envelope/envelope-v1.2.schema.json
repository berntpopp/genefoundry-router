{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/berntpopp/genefoundry-router/main/envelope/envelope-v1.2.schema.json",
  "title": "GeneFoundry response envelope v1.2",
  "description": "The structuredContent object of an MCP tool result that carries upstream data. Unlisted properties are allowed everywhere.",
  "type": "object",
  "required": ["success", "_meta"],
  "properties": {
    "success": { "type": "boolean" },
    "_meta": {
      "type": "object",
      "required": ["request_id", "elapsed_ms"],
      "properties": {
        "request_id": { "type": "string" },
        "elapsed_ms": { "type": "number" }
      }
    }
  },
  "allOf": [{ "$ref": "#/$defs/fenced" }],
  "if": { "type": "object", "properties": { "success": { "const": true } } },
  "then": { "$ref": "#/$defs/success" },
  "else": { "$ref": "#/$defs/error" },
  "$defs": {
    "success": {
      "type": "object",
      "anyOf": [{ "required": ["result"] }, { "required": ["results"] }],
      "properties": {
        "result": { "type": "object" },
        "results": { "type": "array" },
        "_meta": {
          "type": "object",
          "required": ["source", "data_version", "retrieved_at"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "data_version": { "$ref": "#/$defs/text" },
            "retrieved_at": { "$ref": "#/$defs/utc" }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["error_code", "message", "retryable"],
      "properties": {
        "error_code": { "$ref": "#/$defs/text" },
        "message": { "$ref": "#/$defs/text" },
        "retryable": { "type": "boolean" },
        "recovery_action": { "type": "string" }
      }
    },
    "untrusted_text": {
      "type": "object",
      "required": ["text", "provenance", "raw_sha256"],
      "properties": {
        "text": { "type": "string" },
        "provenance": {
          "type": "object",
          "required": ["source", "record_id", "retrieved_at"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "record_id": { "$ref": "#/$defs/text" },
            "retrieved_at": { "$ref": "#/$defs/utc" }
          }
        },
        "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fenced": {
      "$comment": "Any object with kind=untrusted_text, at any depth, is the v1.1 object; its subtree is opaque.",
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "untrusted_text" } } },
      "then": { "$ref": "#/$defs/untrusted_text" },
      "else": { "additionalProperties": { "$ref": "#/$defs/fenced" }, "items": { "$ref": "#/$defs/fenced" } }
    },
    "text": { "type": "string", "pattern": "\\S" },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    }
  }
}
